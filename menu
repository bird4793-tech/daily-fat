        <!-- 左側：66道鹽酥雞攤菜單區 (佔 8 欄) -->
        <div class="lg:col-span-8 p-4 md:p-6 zine-border-r flex flex-col">
            
            <!-- 搜尋與分類篩選列 -->
            <div class="mb-6 flex flex-col sm:flex-row gap-3">
                <div class="relative flex-grow">
                    <input type="text" id="searchInput" placeholder="搜尋鹹酥雞、雞排或搞笑代號..." class="w-full zine-border bg-white px-4 py-2 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-zine-accent">
                    <span class="absolute right-3 top-2.5 text-xs font-mono text-zine-muted">🔍</span>
                </div>
                <div class="flex gap-2 overflow-x-auto pb-2 sm:pb-0" id="categoryBtns">
                    <button onclick="filterCategory('all')" class="cat-btn zine-border px-3 py-2 bg-zine-dark text-zine-paper font-bold text-xs uppercase whitespace-nowrap cursor-pointer">全部品項</button>
                    <button onclick="filterCategory('chicken')" class="cat-btn zine-border px-3 py-2 bg-white font-bold text-xs uppercase whitespace-nowrap cursor-pointer hover:bg-zinc-100">招牌雞肉與魷魚</button>
