            { id: 54, name: "軟骨功大師醬汁蛋豆腐", price: 50, category: "sauce", desc: "外皮刷滿醬汁，裡面嫩到夾不起來。", tag: "超嫩" },
            { id: 55, name: "海綿寶寶親戚醬汁小方干", price: 25, category: "sauce", desc: "方方正正，把獨門醬汁吸得一滴不剩。", tag: "吸汁" },
            { id: 56, name: "長高版醬汁長甜不辣", price: 30, category: "sauce", desc: "刷醬派必點，Q彈鹹甜超唰嘴。", tag: "刷醬必點" },
            { id: 57, name: "綠色爆炸頭醬汁綠花椰菜", price: 45, category: "sauce", desc: "爆炸頭造型完美吸附滿滿醬汁。", tag: "蔬菜類" },
            { id: 58, name: "白髮魔女醬汁白花椰菜", price: 45, category: "sauce", desc: "清脆爽口與濃郁醬香的完美結合。", tag: "爽脆" },
            { id: 59, name: "長不大的玉米醬汁玉米筍", price: 45, category: "sauce", desc: "清甜脆口，減輕吃炸物的罪惡感。", tag: "清甜" },
            { id: 60, name: "高山來的朋友醬汁高麗菜", price: 45, category: "sauce", desc: "炸過再刷醬，比熱炒店還好吃。", tag: "熱炒風" },
            { id: 61, name: "明天見醬汁金針菇", price: 45, category: "sauce", desc: "別號 See You Tomorrow，多汁美味。", tag: "多汁" },
            { id: 62, name: "感動流淚醬汁大洋蔥", price: 40, category: "sauce", desc: "炸過後只剩鮮甜不嗆辣，好吃到想哭。", tag: "鮮甜" },
            { id: 63, name: "刷滿牙縫醬汁甜玉米", price: 40, category: "sauce", desc: "準備好你的牙籤，鹹甜爆汁超推。", tag: "爆汁" },
            { id: 64, name: "敷臉太浪費醬汁小黃瓜", price: 45, category: "sauce", desc: "爽脆解膩第一名，拿來吃比拿來敷臉更讚。", tag: "解膩" },
            { id: 65, name: "美人腿誘惑醬汁筊白筍", price: 50, category: "sauce", desc: "鮮嫩多汁，吃了腿不知道會不會變美。", tag: "鮮嫩" },
            { id: 66, name: "假裝在喝蔬果汁醬汁西洋芹", price: 40, category: "sauce", desc: "超清爽纖維質，吃完這份可以多點一塊雞排。", tag: "清纖維" }
        ];

        let cart = [];
        let currentCategory = 'all';
        let gasWebhookUrl = localStorage.getItem('gas_webhook_url') || '';

        // 初始化載入
        window.onload = function() {
            renderMenu(menuItems);
            updateCartUI();
            if(gasWebhookUrl) {
                document.getElementById('gasUrlInput').value = gasWebhookUrl;
            }
        };

        // 渲染菜單
        function renderMenu(items) {
            const grid = document.getElementById('menuGrid');
            document.getElementById('itemCountDisplay').innerText = `顯示中 ${items.length} 道品項`;
            
            if(items.length === 0) {
                grid.innerHTML = `<div class="col-span-2 text-center py-12 font-mono text-zine-muted">找不到符合條件的美味炸物...</div>`;
                return;
            }

            grid.innerHTML = items.map(item => `
                <div class="zine-border bg-white p-4 flex flex-col justify-between zine-shadow-sm hover:-translate-y-0.5 transition-transform">
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <span class="font-mono text-xs font-bold bg-zine-paper px-2 py-0.5 zine-border">#${item.id < 10 ? '0' + item.id : item.id}</span>
                            <span class="stamp !text-[10px] !py-0 !px-1">${item.tag}</span>
                        </div>
                        <h3 class="font-black text-base mb-1">${item.name}</h3>
                        <p class="text-xs text-zine-muted mb-3 line-clamp-2">${item.desc}</p>
                    </div>
                    <div class="flex justify-between items-center pt-3 border-t border-dashed border-zinc-200 mt-2">
                        <span class="font-mono font-black text-zine-accent text-lg">$${item.price} <span class="text-xs text-zine-dark font-normal">NTD</span></span>
                        <button onclick="addToCart(${item.id})" class="zine-border px-3 py-1 bg-zine-paper hover:bg-zine-dark hover:text-zine-paper font-mono text-xs font-bold transition-all cursor-pointer">
                            + 加入傳票
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // 分類篩選
        function filterCategory(category) {
            currentCategory = category;
            
            // 按鈕樣式切換
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.classList.remove('bg-zine-dark', 'text-zine-paper');
                btn.classList.add('bg-white');
            });
            event.target.classList.remove('bg-white');
            event.target.classList.add('bg-zine-dark', 'text-zine-paper');

            filterMenu();
        }

        // 搜尋與分類綜合過濾
        function filterMenu() {
            const keyword = document.getElementById('searchInput').value.trim().toLowerCase();
            const filtered = menuItems.filter(item => {
                const matchCategory = currentCategory === 'all' || item.category === currentCategory;
                const matchKeyword = item.name.toLowerCase().includes(keyword) || item.desc.toLowerCase().includes(keyword) || item.id.toString() === keyword;
                return matchCategory && matchKeyword;
            });
            renderMenu(filtered);
        }

        // 加入購物車
        function addToCart(id) {
            const item = menuItems.find(i => i.id === id);
            const existing = cart.find(c => c.id === id);
            if(existing) {
                existing.qty++;
            } else {
                cart.push({ ...item, qty: 1 });
            }
            updateCartUI();
        }

        // 變更數量
        function changeQty(id, delta) {
            const item = cart.find(c => c.id === id);
            if(item) {
                item.qty += delta;
                if(item.qty <= 0) {
                    cart = cart.filter(c => c.id !== id);
                }
            }
            updateCartUI();
        }

        // 更新購物車 UI
        function updateCartUI() {
            const listEl = document.getElementById('cartItemsList');
            const countEl = document.getElementById('cartItemCount');
            const totalEl = document.getElementById('cartTotalPrice');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            countEl.innerText = `${totalQty} 項`;
            totalEl.innerText = `$${totalPrice} NTD`;

            if(cart.length === 0) {
                listEl.innerHTML = `
                    <div class="text-center py-8 text-zine-muted font-mono text-sm border-2 border-dashed border-zinc-300">
                        目前傳票空空如也<br>趕快點一份比臉還大的雞排吧！
                    </div>
                `;
                return;
            }

            listEl.innerHTML = cart.map(item => `
                <div class="zine-border bg-zine-paper p-3 flex justify-between items-center text-sm">
                    <div class="pr-2">
                        <div class="font-bold line-clamp-1">${item.name}</div>
                        <div class="font-mono text-xs text-zine-accent">$${item.price} × ${item.qty}</div>
                    </div>
                    <div class="flex items-center gap-1.5 font-mono">
                        <button onclick="changeQty(${item.id}, -1)" class="w-6 h-6 zine-border bg-white flex items-center justify-center font-bold hover:bg-zinc-200 cursor-pointer">-</button>
                        <span class="w-6 text-center font-bold text-xs">${item.qty}</span>
                        <button onclick="changeQty(${item.id}, 1)" class="w-6 h-6 zine-border bg-white flex items-center justify-center font-bold hover:bg-zinc-200 cursor-pointer">+</button>
                    </div>
                </div>
            `).join('');
        }

        // 開啟/關閉設定 Modal
        function openConfigModal() {
            document.getElementById('configModal').classList.remove('hidden');
        }
        function closeConfigModal() {
            document.getElementById('configModal').classList.add('hidden');
        }
        function saveGasConfig() {
            const url = document.getElementById('gasUrlInput').value.trim();
            gasWebhookUrl = url;
            localStorage.setItem('gas_webhook_url', url);
            alert('✅ 試算表 Webhook 連結已儲存成功！');
            closeConfigModal();
        }

        // 提交訂單傳票
        async function submitOrder() {
            const name = document.getElementById('customerName').value.trim();
            const phone = document.getElementById('customerPhone').value.trim();
            const remark = document.getElementById('orderRemark').value.trim();

            if(!name || !phone) {
                alert('⚠️ 請填寫取餐人姓名與聯絡電話！');
                return;
            }
            if(cart.length === 0) {
                alert('⚠️ 您的點餐傳票目前是空的，請先選擇鹹酥雞品項！');
                return;
            }

            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const orderDetails = cart.map(i => `${i.name} x${i.qty}`).join(', ');

            const orderData = {
                name: name,
                phone: phone,
                items: orderDetails,
                total: totalPrice,
                remark: remark || '無',
                timestamp: new Date().toLocaleString()
            };

            if(!gasWebhookUrl) {
                if(confirm('⚠️ 您尚未設定 Google 試算表連動網址。\n點擊「確定」將僅模擬送出，點擊「取消」前往設定。')) {
                    alert(`🎉 模擬訂單送出成功！\n\n【訂單內容】\n姓名：${name}\n電話：${phone}\n品項：${orderDetails}\n總金額：$${totalPrice} NTD\n備註：${orderData.remark}`);
                    cart = [];
                    updateCartUI();
                    document.getElementById('customerName').value = '';
                    document.getElementById('customerPhone').value = '';
                    document.getElementById('orderRemark').value = '';
                } else {
                    openConfigModal();
                }
                return;
            }

            // 發送至 Google Apps Script Webhook
            try {
                const response = await fetch(gasWebhookUrl, {
                    method: 'POST',
                    mode: 'no-cors', // 避免 CORS 問題
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(orderData)
                });

                alert(`🚀 訂單傳票已成功送出並同步至 Google 試算表！\n\n感謝您的光臨，請耐心等候老闆炸得酥酥脆脆！`);
                cart = [];
                updateCartUI();
                document.getElementById('customerName').value = '';
                document.getElementById('customerPhone').value = '';
                document.getElementById('orderRemark').value = '';
            } catch (error) {
                console.error(error);
                alert('❌ 傳票發送失敗，請檢查網路連線或 Apps Script 部署網址是否正確。');
            }
        }
    </script>
</body>
</html>
