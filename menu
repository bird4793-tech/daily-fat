    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['"Noto Serif TC"', 'serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                    colors: {
                        zine: {
                            paper: '#F4F1EA',
                            dark: '#1A1918',
                            accent: '#D32F2F',
                            muted: '#78716C',
                            border: '#1A1918',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #F4F1EA;
            color: #1A1918;
            font-family: 'Noto Serif TC', serif;
        }
        .zine-border {
            border: 2px solid #1A1918;
        }
        .zine-border-b {
            border-bottom: 2px solid #1A1918;
        }
        .zine-border-r {
            border-right: 2px solid #1A1918;
        }
        .zine-shadow {
            box-shadow: 4px 4px 0px #1A1918;
        }
        .zine-shadow-sm {
            box-shadow: 2px 2px 0px #1A1918;
        }
        .stamp {
            display: inline-block;
            padding: 0.15rem 0.5rem;
            border: 2px solid #D32F2F;
            color: #D32F2F;
            font-weight: 900;
            text-transform: uppercase;
            transform: rotate(-3deg);
            font-size: 0.75rem;
            letter-spacing: 0.05em;
        }
        /* 自定義卷軸風格 */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #F4F1EA;
            border-left: 2px solid #1A1918;
        }
        ::-webkit-scrollbar-thumb {
            background: #1A1918;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-zine-accent selection:text-white">

    <!-- 頂部公告 / 標題列 -->
    <header class="zine-border-b bg-zine-paper sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-col md:flex-row justify-between items-center gap-2">
            <div class="flex items-center gap-3">
                <span class="stamp">VOL. 01</span>
                <h1 class="text-2xl font-black tracking-wider uppercase">日日胖 ｜ 肥胖加油站</h1>
                <span class="text-xs font-mono bg-zine-dark text-zine-paper px-2 py-0.5 rounded-none">SALTED CHICKEN STATION</span>
            </div>
            <div class="flex items-center gap-3 text-sm font-mono">
                <button onclick="openConfigModal()" class="zine-border zine-shadow-sm px-3 py-1 bg-white hover:bg-zine-dark hover:text-white transition-all cursor-pointer font-bold flex items-center gap-1">
                    <span>⚙️ 試算表連動設定</span>
                </button>
                <div class="zine-border px-3 py-1 bg-white">
                    <span>營業時間：16:00 - 23:30</span>
                </div>
            </div>
        </div>
    </header>

    <!-- 主體內容區 (雙欄 Layout) -->
