                    🚀 確認無誤，送出訂單傳票
                </button>
            </div>
        </div>
    </main>

    <!-- 底部資訊 -->
    <footer class="zine-border-t bg-zine-paper py-4 text-center font-mono text-xs text-zine-muted">
        <p>© 2026 日日胖 ｜ 肥胖加油站系統 ── 讓熱量再次偉大</p>
    </footer>

    <!-- 設定 Apps Script 網址的 Modal -->
    <div id="configModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
