                    <button onclick="filterCategory('veg')" class="cat-btn zine-border px-3 py-2 bg-white font-bold text-xs uppercase whitespace-nowrap cursor-pointer hover:bg-zinc-100">季節鮮蔬與小點</button>
                    <button onclick="filterCategory('sauce')" class="cat-btn zine-border px-3 py-2 bg-white font-bold text-xs uppercase whitespace-nowrap cursor-pointer hover:bg-zinc-100">獨門秘醬刷烤</button>
                </div>
            </div>

            <!-- 菜單列表格線標頭 -->
            <div class="flex justify-between items-center pb-2 zine-border-b mb-4 font-mono text-xs text-zine-muted">
                <span id="itemCountDisplay">載入中共 66 道品項...</span>
                <span>[ 點擊品項加入點餐傳票 ]</span>
            </div>

            <!-- 菜單品項卡片網格 -->
            <div id="menuGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- 動態生成 66 道惡搞菜品 -->
            </div>
        </div>

        <!-- 右側：點餐傳票 / 購物車區 (佔 4 欄) -->
        <div class="lg:col-span-4 bg-white p-4 md:p-6 flex flex-col justify-between">
            <div>
                <div class="zine-border-b pb-3 mb-4 flex justify-between items-center">
                    <h2 class="text-lg font-black tracking-wider uppercase flex items-center gap-2">
                        <span>📋</span> 點餐傳票 (ORDER TICKET)
                    </h2>
                    <span id="cartItemCount" class="font-mono text-xs bg-zine-accent text-white px-2 py-0.5 font-bold">0 項</span>
                </div>

                <!-- 購物車清單 -->
                <div id="cartItemsList" class="space-y-3 max-h-[40vh] overflow-y-auto pr-1 mb-4">
                    <div class="text-center py-8 text-zine-muted font-mono text-sm border-2 border-dashed border-zinc-300">
                        目前傳票空空如也<br>趕快點一份比臉還大的雞排吧！
                    </div>
                </div>
            </div>

            <!-- 結帳與送出區 -->
            <div class="border-t-2 border-zine-dark pt-4 mt-auto">
                <div class="space-y-3 mb-4">
                    <div>
                        <label class="block text-xs font-mono font-bold mb-1">取餐人姓名 / 綽號 *</label>
                        <input type="text" id="customerName" placeholder="例如：快樂肥宅" class="w-full zine-border px-3 py-2 text-sm font-mono focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-mono font-bold mb-1">聯絡電話 *</label>
                        <input type="tel" id="customerPhone" placeholder="0912-345-678" class="w-full zine-border px-3 py-2 text-sm font-mono focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-mono font-bold mb-1">備註事項 (不要九層塔/加辣等)</label>
                        <input type="text" id="orderRemark" placeholder="老闆我要蒜頭加爆..." class="w-full zine-border px-3 py-2 text-sm font-mono focus:outline-none">
                    </div>
                </div>

